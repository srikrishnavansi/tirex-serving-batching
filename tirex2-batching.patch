+# Licensed under the Apache License, Version 2.0; see LICENSE for details.
+
+"""Dynamic request batching for the forecast endpoints.
+
+Concurrent requests are collected until ``max_batch_size`` series are waiting or
+``max_wait_ms`` has passed since the oldest one arrived, then run as one model
+call per ``prediction_length``. Each caller gets back exactly the forecasts for
+its own series, in its own order. Requests are never split across model calls.
+"""
+
+import asyncio
+import time
+from collections import defaultdict
+from dataclasses import dataclass, field
+
+from starlette.concurrency import run_in_threadpool
+
+from app import metrics
+
+
+def _timed(predict_fn, contexts, prediction_length):
+    start = time.perf_counter()
+    forecasts = predict_fn(contexts, prediction_length)
+    if len(forecasts) != len(contexts):  # results are routed by position, so this must hold
+        raise RuntimeError(f"model returned {len(forecasts)} forecasts for {len(contexts)} series")
+    return forecasts, start, time.perf_counter()
+
+
+async def _call_model(predict_fn, contexts, prediction_length, arrivals):
+    """Run one model call off the event loop and record batch size, queue wait and model latency."""
+    forecasts, start, end = await run_in_threadpool(_timed, predict_fn, contexts, prediction_length)
+    metrics.batch_size.observe(len(contexts))
+    metrics.model_latency.observe(end - start)
+    for arrived in arrivals:
+        metrics.queue_wait.observe(start - arrived)
+    return forecasts
+
+
+def unbatched(predict_fn):
+    """Stock behaviour: each request makes its own model call on the shared thread pool."""
+
+    async def predict(contexts, prediction_length):
+        return await _call_model(predict_fn, contexts, prediction_length, [time.perf_counter()])
+
+    return predict
+
+
+@dataclass
+class _Pending:
+    contexts: list
+    prediction_length: int
+    future: asyncio.Future
+    arrived: float = field(default_factory=time.perf_counter)
+
+
+def _fail(item: _Pending, exc: BaseException) -> None:
+    if not item.future.done():
+        item.future.set_exception(exc)
+
+
+class MicroBatcher:
+    """Merges concurrent ``predict(contexts, prediction_length)`` calls into batched model calls."""
+
+    def __init__(self, predict_fn, max_batch_size: int = 256, max_wait_ms: float = 10.0):
+        self.predict_fn = predict_fn  # sync: (list of series, prediction_length) -> one forecast per series
+        self.max_batch_size = max_batch_size
+        self.max_wait = max_wait_ms / 1000
+        self._queue: asyncio.Queue | None = None
+        self._worker: asyncio.Task | None = None
+
+    async def predict(self, contexts, prediction_length):
+        contexts = list(contexts)
+        if not contexts:  # keep the stock error for an empty request instead of silently returning []
+            return await _call_model(self.predict_fn, contexts, prediction_length, [time.perf_counter()])
+        if self._worker is None:  # created lazily so it binds to the server's running event loop
+            self._queue = asyncio.Queue()  # ponytail: unbounded; add a max size + 503 if overload matters
+            self._worker = asyncio.create_task(self._run())
+        item = _Pending(contexts, prediction_length, asyncio.get_running_loop().create_future())
+        self._queue.put_nowait(item)
+        return await item.future
+
+    async def _run(self):
+        carry = None
+        while True:
+            first = carry or await self._queue.get()
+            carry, batch, size = None, [first], len(first.contexts)
+            # The window counts from the oldest request, so requests that queued up while
+            # the model was busy are dispatched at once instead of waiting another window.
+            deadline = first.arrived + self.max_wait
+            while size < self.max_batch_size:
+                timeout = deadline - time.perf_counter()
+                try:
+                    if timeout <= 0:
+                        item = self._queue.get_nowait()
+                    else:
+                        item = await asyncio.wait_for(self._queue.get(), timeout)
+                except (asyncio.QueueEmpty, TimeoutError):
+                    break
+                if size + len(item.contexts) > self.max_batch_size:
+                    carry = item  # does not fit: it opens the next batch
+                    break
+                batch.append(item)
+                size += len(item.contexts)
+
+            by_length = defaultdict(list)
+            for item in batch:
+                by_length[item.prediction_length].append(item)
+            for prediction_length, items in by_length.items():
+                await self._run_group(items, prediction_length)
+
+    async def _run_group(self, items: list[_Pending], prediction_length: int) -> None:
+        items = [item for item in items if not item.future.done()]  # drop callers that already went away
+        if not items:
+            return
+        contexts = [series for item in items for series in item.contexts]
+        try:
+            forecasts = await _call_model(self.predict_fn, contexts, prediction_length, [i.arrived for i in items])
+        except Exception as exc:
+            if len(items) == 1:
+                _fail(items[0], exc)
+                return
+            # One bad request must not fail its batch-mates: rerun each request on its own.
+            for item in items:
+                await self._run_group([item], prediction_length)
+            return
+
+        start = 0
+        for item in items:
+            end = start + len(item.contexts)
+            if not item.future.done():
+                item.future.set_result(forecasts[start:end])
+            start = end
