index 0000000..8a0c9de
--- /dev/null
+++ b/inference/app/metrics.py
@@ -0,0 +1,122 @@
+# Licensed under the Apache License, Version 2.0; see LICENSE for details.
+
+"""Hand-written Prometheus text metrics for the forecast server.
+
+All observations happen on the event-loop thread, so no locks are needed.
+"""
+
+import bisect
+import time
+from collections import Counter, deque
+
+from fastapi import FastAPI
+from fastapi.responses import PlainTextResponse
+
+LATENCY_BUCKETS = (0.001, 0.0025, 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0, 30.0)
+BATCH_BUCKETS = (1, 2, 4, 8, 16, 32, 64, 128, 256, 512)
+FORECAST_PATHS = ("/univariate/", "/multivariate/")
+
+
+class Histogram:
+    def __init__(self, name: str, help: str, buckets):
+        self.name, self.help, self.buckets = name, help, tuple(buckets)
+        self.counts = [0] * len(self.buckets)
+        self.sum = 0.0
+        self.count = 0
+
+    def observe(self, value: float) -> None:
+        i = bisect.bisect_left(self.buckets, value)  # first bucket with le >= value
+        if i < len(self.counts):
+            self.counts[i] += 1
+        self.sum += value
+        self.count += 1
+
+    def render(self) -> list[str]:
+        lines = [f"# HELP {self.name} {self.help}", f"# TYPE {self.name} histogram"]
+        cumulative = 0
+        for le, n in zip(self.buckets, self.counts):
+            cumulative += n
+            lines.append(f'{self.name}_bucket{{le="{le}"}} {cumulative}')
+        lines += [
+            f'{self.name}_bucket{{le="+Inf"}} {self.count}',
+            f"{self.name}_sum {self.sum}",
+            f"{self.name}_count {self.count}",
+        ]
+        return lines
+
+
+class WindowSummary:
+    """p50/p95 over the most recent requests, plus lifetime sum/count."""
+
+    def __init__(self, name: str, help: str, window: int = 1000, quantiles=(0.5, 0.95)):
+        self.name, self.help, self.quantiles = name, help, quantiles
+        self.recent: deque[float] = deque(maxlen=window)
+        self.sum = 0.0
+        self.count = 0
+
+    def observe(self, value: float) -> None:
+        self.recent.append(value)
+        self.sum += value
+        self.count += 1
+
+    def render(self) -> list[str]:
+        lines = [f"# HELP {self.name} {self.help}", f"# TYPE {self.name} summary"]
+        ordered = sorted(self.recent)
+        for q in self.quantiles:
+            value = ordered[min(len(ordered) - 1, int(q * len(ordered)))] if ordered else float("nan")
+            lines.append(f'{self.name}{{quantile="{q}"}} {value}')
+        lines += [f"{self.name}_sum {self.sum}", f"{self.name}_count {self.count}"]
+        return lines
+
+
+requests_total: Counter = Counter()  # (path, status) -> count
+batch_size = Histogram("tirex_batch_size", "Series per model call.", BATCH_BUCKETS)
+queue_wait = Histogram(
+    "tirex_queue_wait_seconds", "Time from request arrival until its model call started.", LATENCY_BUCKETS
+)
+model_latency = Histogram("tirex_model_latency_seconds", "Duration of one model call.", LATENCY_BUCKETS)
+request_latency = WindowSummary(
+    "tirex_request_latency_seconds", "End-to-end forecast request latency (quantiles over the last 1000 requests)."
+)
+
+
+def render() -> str:
+    lines = ["# HELP tirex_requests_total Forecast requests served.", "# TYPE tirex_requests_total counter"]
+    for (path, status), n in sorted(requests_total.items()):
+        lines.append(f'tirex_requests_total{{path="{path}",status="{status}"}} {n}')
+    for metric in (batch_size, queue_wait, model_latency, request_latency):
+        lines += metric.render()
+    return "\n".join(lines) + "\n"
+
+
+class _RequestTimer:
+    """Pure ASGI middleware (streams for /mcp pass through untouched) timing forecast requests."""
+
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] != "http" or not scope["path"].startswith(FORECAST_PATHS):
+            return await self.app(scope, receive, send)
+        start, status = time.perf_counter(), 500
+
+        async def send_and_capture(message):
+            nonlocal status
+            if message["type"] == "http.response.start":
+                status = message["status"]
+            await send(message)
+
+        try:
+            await self.app(scope, receive, send_and_capture)
+        finally:
+            requests_total[(scope["path"], status)] += 1
+            request_latency.observe(time.perf_counter() - start)
+
+
+def install(app: FastAPI) -> None:
+    """Add request timing and a Prometheus-format GET /metrics to ``app``."""
+    app.add_middleware(_RequestTimer)
+
+    @app.get("/metrics", include_in_schema=False)
+    async def metrics() -> PlainTextResponse:  # async: runs on the loop thread, where the observations happen
+        return PlainTextResponse(render(), media_type="text/plain; version=0.0.4")
